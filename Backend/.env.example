# ==========================================
# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ==========================================

# Port (Render sets this automatically in production — leave as 3000 for local dev)
PORT=3000

# MongoDB Connection String (Atlas URI in production)
MONGO_URI=mongodb://localhost:27017/talentmind_ai

# JWT Secret — use a strong random string (min 32 chars) in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Google Gemini API Key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=your_google_gemini_api_key_here

# Frontend URL — set this to your exact Vercel deployment URL in production
# Example: https://talentmind-ai.vercel.app
FRONTEND_URL=http://localhost:5173

# Node environment: 'development' or 'production'
NODE_ENV=development
