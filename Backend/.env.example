# ==========================================
# Backend Environment Variables Example
# Copy this file to a new file named '.env' and fill in your values.
# ==========================================

# Port for the Express server to listen on (Render sets this dynamically, defaults to 3000 locally)
PORT=3000

# MongoDB Connection String (Atlas URI in production or local connection)
MONGO_URI=mongodb://localhost:27017/hiremind_ai

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key from Google AI Studio
GOOGLE_GENAI_API_KEY=your_google_gemini_api_key_here

# Frontend Application URL (Used to configure CORS in production)
# In production, set this to your Vercel URL: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Node Environment: 'development' or 'production'
NODE_ENV=development
